package pages

import (
	"context"
	"fmt"
	"time"

	"morning30/assets"
	"morning30/internal/app"
	"morning30/internal/auth"
	"morning30/internal/content"
	"morning30/internal/i18n"
	"morning30/path"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
)

// homePage is the dashboard: today's session, the date-based streak calendar,
// and the separate looping 30-day cycle track.
type homePage struct {
	sess auth.Session
	auth doors.Source[auth.Session]
	path doors.Source[path.Path]
}

elem (h homePage) Main() {
	~{
		l := i18n.Lang(h.sess.Lang)
		today := app.Today()
		pos := app.CurrentPosition(h.sess.UserID)
		streak, _ := app.DB.Streak(h.sess.UserID, today)
		doneToday, _ := app.DB.HasActivity(h.sess.UserID, today)

		cycle := pos/content.TotalDays + 1
		curDay := pos%content.TotalDays + 1
		w := app.UserWorkout(h.sess.UserID, curDay)
		mainRounds := 1
		for _, item := range w.Items {
			if item.Slot == content.Main && item.Round > mainRounds {
				mainRounds = item.Round
			}
		}

		startLabel := i18n.T(l, "home.start")
		if pos > 0 {
			startLabel = i18n.T(l, "home.continue")
		}
		if doneToday {
			startLabel = i18n.T(l, "home.repeat")
		}

		greeting := i18n.T(l, "home.morning")
		if h.sess.Name != "" {
			greeting += ", " + h.sess.Name
		}
		greeting += "!"

		monthOffset := doors.NewSource(0)
		selected := app.SelectedPrograms(h.sess.UserID)
		resumeData := map[string]any{"userId": h.sess.UserID, "position": pos, "programKey": app.WorkoutProgramKey(h.sess.UserID), "streak": streak, "restartAt": app.CycleRestartAt(h.sess.UserID)}
	}
	<title>~(i18n.T(l, "app.name"))</title>
	<main class="screen">
		~(header{sess: h.sess, auth: h.auth, path: h.path, streak: streak, title: greeting})

		~(if h.sess.IsGuest {
			<div class="guest-note">
				<span>~(i18n.T(l, "guest.note"))</span>
				~>doors.ALink{Model: path.Path{Page: path.Register}} <a class="btn primary small">~(i18n.T(l, "auth.register"))</a>
			</div>
		})

		<section class="hero">
			~(if doneToday {
				<p class="done-banner">~(i18n.T(l, "home.done_today"))</p>
			})
			~>doors.ALink{Model: path.Path{Page: path.Programs}} <a class="hero-program">~(app.ProgramTitle(h.sess.UserID, h.sess.Lang))</a>
			<div class="hero-cycle">~(i18n.T(l, "home.cycle"), " ", cycle)~(if !w.FixedDifficulty && h.sess.Level != 0 { ~("  ·  ", i18n.T(l, "home.level"), " ", levelLabel(l, h.sess.Level)) })</div>
			<div class="day-num">~(i18n.T(l, "home.day"), " ", curDay)</div>
			<div class="day-meta">
				<span>~(i18n.T(l, "home.rounds"), ": ", mainRounds)</span>
				~>doors.ALink{Model: path.Path{Page: path.Today}} <a class="day-count">~(len(w.Items), " ", i18n.T(l, "home.exercises"))</a>
				<span>~(i18n.T(l, "home.est"), " ", minutes(w.EstSec), " ", i18n.T(l, "home.min"))</span>
			</div>
			~// An interrupted workout replaces the start button with one "Continue".
			~>doors.ALink{Model: path.Path{Page: path.Start}} <a class="btn primary big start-workout">~(startLabel)</a>
			<a class="btn primary big resume-workout hidden" href="/">~(i18n.T(l, "home.continue"))</a>
			<p class="home-save-status hidden" role="status" data-pending=(i18n.T(l, "done.save_pending")) data-saved=(i18n.T(l, "done.saved"))></p>
		</section>

		~(h.programs(selected))

		<section class="streak-row">
			<span class="fire">🔥</span>
			<span class="streak-n">~(streak)</span>
			<span class="streak-label">~(i18n.T(l, "home.streak"), " · ", streak, " ", i18n.T(l, "home.days"))</span>
		</section>

		~// Date-based habit calendar (drives the streak).
		<section class="calendar">
			~(h.month(monthOffset))
		</section>

		~// The looping 30-day program cycle (separate from the date calendar).
		<section class="cycle">
			<h3>~(i18n.T(l, "home.cycle"), " ", cycle)</h3>
			~(if !w.FixedDifficulty {
			<div class="diff">
				<div class="diff-bar"></div>
				<span class="diff-label">~(i18n.T(l, "home.diff"))</span>
			</div>
			})
			<div class="cyc-grid">
				~(for d := 1; d <= content.TotalDays; d++ {
					~(h.cycleCell(d, curDay))
				})
			</div>
		</section>
		<script src=(assets.WorkoutHome()) inline data:resume=(resumeData)></script>
	</main>
}

// programs offers quick switching. A newcomer who has not picked anything sees
// popular ready programs and the link to all of them; once the user has
// programs of their own, only their other selected programs are shown (and
// nothing when there are none), so the home screen stays quiet.
elem (h homePage) programs(selected []app.SelectedView) {
	~{
		l := i18n.Lang(h.sess.Lang)
		var others []app.SelectedView
		for _, p := range selected {
			if !p.Current {
				others = append(others, p)
			}
		}
		newcomer := len(selected) == 0 && !app.HasCustomProgram(h.sess.UserID)
		current := app.CurrentSource(h.sess.UserID)
	}
	~(if newcomer {
		<section class="courses">
			<div class="courses-head">
				<h3>~(i18n.T(l, "home.programs_ready"))</h3>
				~>doors.ALink{Model: path.Path{Page: path.Programs}} <a class="all-link">~(i18n.T(l, "home.all_programs"))</a>
			</div>
			<div class="course-list">
				~(for _, key := range content.PopularKeys() {
					~{
						p, _ := content.ReadyByKey(key)
						first, peak := content.MinutesSpan(p.Build())
					}
					~>doors.AClick{On: h.pickReady(key)} <button class=(courseClass(key == current)) type="button">
						<span class="course-title">~(p.TitleIn(h.sess.Lang))</span>
						<span class="course-meta">~(first, "–", peak, " ", i18n.T(l, "home.min"))</span>
					</button>
				})
			</div>
		</section>
	} else if len(others) > 0 {
		<section class="courses">
			<div class="courses-head">
				<h3>~(i18n.T(l, "home.switch"))</h3>
			</div>
			<div class="course-list">
				~(for _, p := range others {
					~>doors.AClick{On: h.pickSelected(p.ID)} <button class="course-card" type="button">
						<span class="course-title">~(p.Name)</span>
						<span class="course-meta">~(i18n.T(l, "programs.day"), " ", p.Day)</span>
					</button>
				})
			</div>
		</section>
	})
}

func courseClass(on bool) string {
	if on {
		return "course-card on"
	}
	return "course-card"
}

// pickReady switches to a ready program and reloads the home screen.
func (h homePage) pickReady(key string) func(context.Context, doors.RequestPointer) bool {
	return func(ctx context.Context, r doors.RequestPointer) bool {
		if app.SelectReady(h.sess.UserID, key, h.sess.Lang) == nil {
			_ = r.After(doors.ActionLocationReload{})
		}
		return false
	}
}

// pickSelected switches to one of the user's selected programs.
func (h homePage) pickSelected(id int64) func(context.Context, doors.RequestPointer) bool {
	return func(ctx context.Context, r doors.RequestPointer) bool {
		if app.SelectByID(h.sess.UserID, id) == nil {
			_ = r.After(doors.ActionLocationReload{})
		}
		return false
	}
}

// month renders the date calendar for the current month ± offset, reactively.
elem (h homePage) month(monthOffset doors.Source[int]) {
	~(monthOffset.Bind(elem(off int) {
		~{
			now := time.Now()
			base := time.Date(now.Year(), now.Month(), 1, 0, 0, 0, 0, time.Local)
			disp := base.AddDate(0, off, 0)
			year := disp.Year()
			month := int(disp.Month())
			daysIn := time.Date(year, time.Month(month)+1, 0, 0, 0, 0, 0, time.Local).Day()
			lead := (int(disp.Weekday()) + 6) % 7 // Monday-first leading blanks
			first := disp.Format("2006-01-02")
			last := time.Date(year, time.Month(month), daysIn, 0, 0, 0, 0, time.Local).Format("2006-01-02")
			acts, _ := app.DB.ActivityInRange(h.sess.UserID, first, last)
			todayStr := app.Today()
			l := i18n.Lang(h.sess.Lang)
		}
		<div class="cal-head">
			~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
				monthOffset.Mutate(ctx, func(o int) int { return o - 1 })
				return false
			}} <button class="cal-nav" type="button">‹</button>
			<span class="cal-title">~(i18n.Month(l, month), " ", year)</span>
			~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
				monthOffset.Mutate(ctx, func(o int) int { return o + 1 })
				return false
			}} <button class="cal-nav" type="button">›</button>
		</div>
		<div class="cal-week">
			~(for wd := 0; wd < 7; wd++ {
				<span>~(i18n.Weekday(l, wd))</span>
			})
		</div>
		<div class="cal-grid month">
			~(for b := 0; b < lead; b++ {
				<div class="cal-blank"></div>
			})
			~(for dd := 1; dd <= daysIn; dd++ {
				~(h.dayCell(year, month, dd, acts, todayStr))
			})
		</div>
	}))
}

// dayCell renders one date cell, marked when the user worked out that day.
elem (h homePage) dayCell(year, month, dd int, acts map[string]bool, todayStr string) {
	~{
		ds := fmt.Sprintf("%04d-%02d-%02d", year, month, dd)
		cls := "cal-day"
		if acts[ds] {
			cls += " act"
		}
		if ds == todayStr {
			cls += " today"
		}
	}
	<div class=(cls)>
		~(if acts[ds] {
			🔥
		} else {
			~(dd)
		})
	</div>
}

// cycleCell renders one of the 30 program days; sequential, looping each cycle.
elem (h homePage) cycleCell(d, current int) {
	~{
		done := d < current
		isCurrent := d == current
		locked := d > current
		cls := "cell"
		if done {
			cls += " done"
		}
		if isCurrent {
			cls += " current"
		}
		if locked {
			cls += " locked"
		}
	}
	~// Every day is tappable — jump straight into that day's program.
	~>doors.ALink{Model: path.Path{Page: path.Day, Day: d}} <a class=(cls)>
		~(if done {
			✓
		} else {
			~(d)
		})
	</a>
}
