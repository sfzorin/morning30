package pages

import (
	"github.com/doors-dev/gox"
)

// icon draws a small outline icon (24×24 grid, current text colour) so
// buttons never rely on text symbols or emoji that render differently on
// every phone. filled paints the shape (used for a selected star).
elem icon(name string, filled bool) {
	~{
		class := "ic ic-" + name // the name lets right-to-left layouts mirror arrows
		if filled {
			class += " fill"
		}
	}
	<svg class=(class) viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		~(if name == "back" {
			<path d="M5 12h14"></path><path d="M5 12l6 6"></path><path d="M5 12l6-6"></path>
		} else if name == "prev" {
			<path d="M15 6l-6 6 6 6"></path>
		} else if name == "next" {
			<path d="M9 6l6 6-6 6"></path>
		} else if name == "to" {
			<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
		} else if name == "trophy" {
			<path d="M8 21h8"></path><path d="M12 17v4"></path><path d="M7 4h10"></path><path d="M17 4v8a5 5 0 0 1-10 0V4"></path><circle cx="5" cy="9" r="2"></circle><circle cx="19" cy="9" r="2"></circle>
		} else if name == "check" {
			<path d="M5 12l5 5L20 7"></path>
		} else if name == "up" {
			<path d="M12 19V5"></path><path d="M6 11l6-6 6 6"></path>
		} else if name == "down" {
			<path d="M12 5v14"></path><path d="M6 13l6 6 6-6"></path>
		} else if name == "close" {
			<path d="M18 6L6 18"></path><path d="M6 6l12 12"></path>
		} else if name == "plus" {
			<path d="M12 5v14"></path><path d="M5 12h14"></path>
		} else if name == "minus" {
			<path d="M5 12h14"></path>
		} else if name == "edit" {
			<path d="M4 20h4L18.5 9.5a2.83 2.83 0 0 0-4-4L4 16v4"></path><path d="M13.5 6.5l4 4"></path>
		} else if name == "star" {
			<path d="M12 17.75l-6.17 3.25 1.18-6.88-5-4.87 6.9-1L12 2l3.09 6.25 6.9 1-5 4.87 1.18 6.88z"></path>
		} else if name == "info" {
			<circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 12h1v4h1"></path>
		} else if name == "replace" {
			<path d="M7 10h14l-4-4"></path><path d="M17 14H3l4 4"></path>
		} else if name == "sparkles" {
			<path d="M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2-2a2 2 0 0 1-2-2a2 2 0 0 1-2 2"></path><path d="M16 6a2 2 0 0 1 2 2a2 2 0 0 1 2-2a2 2 0 0 1-2-2a2 2 0 0 1-2 2"></path><path d="M9 18a6 6 0 0 1 6-6a6 6 0 0 1-6-6a6 6 0 0 1-6 6a6 6 0 0 1 6 6"></path>
		} else if name == "settings" {
			<path d="M4 6h8"></path><path d="M16 6h4"></path><circle cx="14" cy="6" r="2"></circle><path d="M4 12h2"></path><path d="M10 12h10"></path><circle cx="8" cy="12" r="2"></circle><path d="M4 18h11"></path><path d="M19 18h1"></path><circle cx="17" cy="18" r="2"></circle>
		})
	</svg>
}

var _ = gox.Elem(nil)
