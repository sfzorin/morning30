package pages

import (
	"fmt"
	"strconv"

	"morning30/assets"
	"morning30/internal/app"
	"morning30/internal/auth"
	"morning30/internal/catalog"
	"morning30/internal/content"
	"morning30/internal/i18n"
	"morning30/path"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
)

// playerRepl is the minimal data for a manual exercise replacement.
type playerRepl struct {
	ID      string `json:"id"`
	Name    string `json:"name"`
	Unit    string `json:"unit"`
	Value   int    `json:"value"`
	Scale   bool   `json:"scale"`
	PerSide bool     `json:"perSide"`
	SVG     string   `json:"svg"`
	Frames  []string `json:"frames,omitempty"`
	Animation *app.ExerciseDemo `json:"animation,omitempty"`
	Hint    string   `json:"hint"`
	Warning string `json:"warning"`
}

type playerItem struct {
	ID      string `json:"id"`
	Unit    string `json:"unit"`
	Value   int    `json:"value"` // base (level-0) value; the client scales when Scale is true
	Scale   bool   `json:"scale"` // main exercises scale with the difficulty level
	Slot    string `json:"slot"`
	PerSide bool   `json:"perSide"`
	Round   int    `json:"round"`
	Rest    int    `json:"rest"`
	SideRest int `json:"sideRest,omitempty"`
	Name    string `json:"name"`
	Hint    string `json:"hint"`    // short on-screen cue (localized)
	Warning string   `json:"warning"` // inline safety warning (localized)
	SVG     string   `json:"svg"`
	Frames  []string `json:"frames,omitempty"`
	Animation *app.ExerciseDemo `json:"animation,omitempty"`
	// Detail card (Russian canonical content).
	Desc      string   `json:"desc"`
	HowTo     []string `json:"howTo"`
	Correct   []string `json:"correct"`
	Wrong     []string `json:"wrong"`
	Breathing string   `json:"breathing"`
	Safety    string   `json:"safety"`
	// Non-blocking voice cues.
	VStart  string   `json:"vStart"`
	VMid    []string `json:"vMid"`
	VLast   string   `json:"vLast"`
	VFinish string   `json:"vFinish"`
	// Manual replacement (nil if none).
	Repl *playerRepl `json:"repl,omitempty"`
}

type playerPayload struct {
	UserID    int64             `json:"userId"`
	Position  int               `json:"position"`
	ProgramKey string           `json:"programKey"`
	ResumeKey string            `json:"resumeKey"`
	RestartAt string            `json:"restartAt,omitempty"`
	Day       int               `json:"day"`
	Lang      string            `json:"lang"`
	BCP47     string            `json:"bcp47"`
	Voice     bool              `json:"voice"`
	VoiceMode string            `json:"voiceMode"`
	Name      string            `json:"name"`
	FixedDifficulty bool        `json:"fixedDifficulty,omitempty"`
	SelfManagedSides bool       `json:"selfManagedSides,omitempty"`
	Level     int               `json:"level"` // current difficulty level (−3..+3); the client scales main exercises
	Items     []playerItem      `json:"items"`
	Labels    map[string]string `json:"labels"`
	Cues      map[string]string `json:"cues"`
	Enc       []string          `json:"enc"`
}

func firstFrame(frames []string) string {
	if len(frames) == 0 {
		return ""
	}
	return frames[0]
}

// workoutPage renders the client-driven player for one day.
type workoutPage struct {
	sess auth.Session
	day  int
	path doors.Source[path.Path]
}

func (w workoutPage) clampDay() int {
	d := w.day
	if d < 1 {
		d = app.CurrentPosition(w.sess.UserID)%content.TotalDays + 1
	}
	if d > content.TotalDays {
		d = content.TotalDays
	}
	return d
}

// voiceFor returns the cues for an exercise. Exercises/languages with per-exercise
// content use those phrases; others fall back to the generic localized cues.
func (w workoutPage) voiceFor(l i18n.Lang, hasVoice bool, d content.Detail) (start string, mid []string, last, finish string) {
	if hasVoice {
		start, mid, last, finish = d.Voice.Start, d.Voice.Mid, d.Voice.Last, d.Voice.Finish
	}
	if start == "" {
		start = i18n.Cue(l, "go")
	}
	if finish == "" {
		finish = i18n.Cue(l, "well_done")
	}
	if last == "" {
		last = i18n.Cue(l, "five")
	}
	return
}

// replFor returns the manual-replacement item for an exercise (nil if none).
func (w workoutPage) replFor(l i18n.Lang, cat catalog.Catalog, sex, id string, value int) *playerRepl {
	ex, ok := cat.Def(id)
	if !ok || ex.Replacement == "" {
		return nil
	}
	rid := ex.Replacement
	r, ok := cat.Def(rid)
	if !ok {
		return nil
	}
	frames := app.ExerciseFrames(cat, rid, sex)
	return &playerRepl{
		ID:      rid,
		Name:    cat.Name(l, rid),
		Unit:    string(r.Unit),
		Value:   content.ConvertValue(ex.Unit, r.Unit, value),
		PerSide: r.PerSide,
		SVG:     firstFrame(frames),
		Frames:  frames,
		Animation: app.ExerciseAnimation(cat, rid, sex),
		Hint:    cat.Hint(l, rid),
		Warning: cat.Warning(l, rid),
	}
}

// playerData is everything the client player needs. Doors JSON-encodes this
// into $data("payload") as an object (not a double-encoded string).
func (w workoutPage) playerData() playerPayload {
	l := i18n.Lang(w.sess.Lang)
	day := w.clampDay()
	wk, level := app.UserWorkoutBase(w.sess.UserID, day) // base values; client scales by level
	cat := app.UserCatalog(w.sess.UserID)
	sex := app.DB.GetSex(w.sess.UserID)

	items := make([]playerItem, 0, len(wk.Items))
	for _, it := range wk.Items {
		id := it.ExerciseID
		scale := it.Slot == content.Main && !wk.FixedDifficulty
		d, _ := cat.Detail(l, id)
		vs, vm, vl, vf := w.voiceFor(l, cat.HasVoiceLang(l, id), d)
		repl := w.replFor(l, cat, sex, id, it.Value)
		if repl != nil {
			repl.Scale = scale
		}
		frames := app.ExerciseFrames(cat, id, sex)
		items = append(items, playerItem{
			ID:        id,
			Unit:      string(it.Unit),
			Value:     it.Value,
			Scale:     scale,
			Slot:      string(it.Slot),
			PerSide:   it.PerSide,
			Round:     it.Round,
			Rest:      it.Rest,
			SideRest:  it.SideRest,
			Name:      cat.Name(l, id),
			Hint:      cat.Hint(l, id),
			Warning:   cat.Warning(l, id),
			SVG:       firstFrame(frames),
			Frames:    frames,
			Animation: app.ExerciseAnimation(cat, id, sex),
			Desc:      d.Desc,
			HowTo:     d.HowTo,
			Correct:   d.Correct,
			Wrong:     d.Wrong,
			Breathing: d.Breathing,
			Safety:    d.Safety,
			VStart:    vs,
			VMid:      vm,
			VLast:     vl,
			VFinish:   vf,
			Repl:      repl,
		})
	}

	labels := map[string]string{
		"warmup":     i18n.T(l, "workout.warmup"),
		"main":       i18n.T(l, "workout.main"),
		"cooldown":   i18n.T(l, "workout.cooldown"),
		"round":      i18n.T(l, "workout.round"),
		"rest":       i18n.T(l, "workout.rest"),
		"ready":      i18n.T(l, "workout.get_ready"),
		"next":       i18n.T(l, "workout.next"),
		"skip":       i18n.T(l, "workout.skip"),
		"prev":       i18n.T(l, "workout.prev"),
		"done":       i18n.T(l, "workout.done"),
		"sec":        i18n.T(l, "workout.sec"),
		"reps":       i18n.T(l, "workout.x_reps"),
		"breaths":    i18n.T(l, "workout.breaths"),
		"side":       i18n.T(l, "workout.side"),
		"per_side":   i18n.T(l, "workout.per_side"),
		"done_title": i18n.T(l, "done.title"),
		"bravo":      i18n.T(l, "done.bravo"),
		"day_done":   i18n.T(l, "done.day_done"),
		"streak":     i18n.T(l, "done.streak"),
		"back_home":  i18n.T(l, "done.back_home"),
		"difficulty": i18n.T(l, "settings.difficulty"),
		"harder":     i18n.T(l, "workout.harder"),
		"easier":     i18n.T(l, "workout.easier"),
		"mistake_reminder": i18n.T(l, "workout.mistake_reminder"),
		"resume_title": i18n.T(l, "workout.resume_title"),
		"resume": i18n.T(l, "workout.resume"),
		"restart": i18n.T(l, "workout.restart"),
		"saving": i18n.T(l, "done.saving"),
		"save_pending": i18n.T(l, "done.save_pending"),
		"save_retry": i18n.T(l, "done.save_retry"),
		"save_unavailable": i18n.T(l, "done.save_unavailable"),
		"saved": i18n.T(l, "done.saved"),
		"demo_play": i18n.T(l, "demo.play"),
		"demo_pause": i18n.T(l, "demo.pause"),
		"demo_frame": i18n.T(l, "demo.frame"),
		"demo_both": i18n.T(l, "demo.both"),
	}
	cues := map[string]string{
		"ready":       i18n.Cue(l, "ready"),
		"go":          i18n.Cue(l, "go"),
		"rest":        i18n.Cue(l, "rest"),
		"next":        i18n.Cue(l, "next"),
		"halfway":     i18n.Cue(l, "halfway"),
		"last":        i18n.Cue(l, "last"),
		"well_done":   i18n.Cue(l, "well_done"),
		"workout_end": i18n.Cue(l, "workout_end"),
		"switch_side": i18n.Cue(l, "switch_side"),
		"next_ex":     i18n.Cue(l, "next_ex"),
		"reps":        i18n.Cue(l, "reps"),
		"seconds":     i18n.Cue(l, "seconds"),
		"avoid":       i18n.Cue(l, "avoid"),
	}
	enc := make([]string, 0, 20)
	for n := 0; n < 20; n++ {
		enc = append(enc, i18n.T(l, "enc."+strconv.Itoa(n)))
	}

	mode := w.sess.VoiceMode
	if mode == "" {
		mode = "normal"
	}
	position := app.CurrentPosition(w.sess.UserID)
	programKey := app.WorkoutProgramKey(w.sess.UserID)
	p := playerPayload{
		UserID: w.sess.UserID,
		Position: position,
		ProgramKey: programKey,
		ResumeKey: fmt.Sprintf("%s:%d:%d", programKey, position, day),
		RestartAt: app.CycleRestartAt(w.sess.UserID),
		Day:       day,
		Lang:      w.sess.Lang,
		BCP47:     i18n.BCP47(l),
		Voice:     w.sess.Voice,
		VoiceMode: mode,
		Name:      w.sess.Name,
		Level:     level,
		FixedDifficulty: wk.FixedDifficulty,
		SelfManagedSides: wk.SelfManagedSides,
		Items:     items,
		Labels: labels,
		Cues:   cues,
		Enc:    enc,
	}
	return p
}

elem (w workoutPage) Main() {
	~{
		l := i18n.Lang(w.sess.Lang)
		payload := w.playerData()
	}
	<title>~(i18n.T(l, "app.name"))</title>
	<div class="player">
		<div class="player-top">
			~>doors.ALink{Model: path.Path{Page: path.Home}} <a class="quit" aria-label=(i18n.T(l, "workout.quit"))>✕</a>
			<div class="pbar"></div>
			<div class="phase"></div>
		</div>

		~// In-workout difficulty nudge (applies to all remaining sets this session).
		<div class="lvl-row">
			<button class="lvl-btn lvl-down" type="button" aria-label=(i18n.T(l, "workout.easier"))>−</button>
			<span class="lvl-label"></span>
			<button class="lvl-btn lvl-up" type="button" aria-label=(i18n.T(l, "workout.harder"))>+</button>
		</div>

		<div class="stage">
			<div class="ex-index"></div>
			<button class="ex-visual" type="button" aria-label=(i18n.T(l, "info.how"))><img class="ex-svg" alt=""></button>
			<div class="demo-caption hidden"></div>
			<div class="ex-name"></div>
			<button class="info-btn" type="button" aria-label=(i18n.T(l, "info.technique"))>ⓘ ~(i18n.T(l, "info.how"))</button>
			<div class="ex-value"></div>
		</div>

		<div class="done-row">
			<button class="ctl-done btn primary" type="button"></button>
		</div>
		<div class="controls">
			<button class="ctl-prev btn" type="button"></button>
			<button class="ctl-skip btn" type="button"></button>
		</div>

		<div class="rest-overlay hidden">
			<div class="rest-index"></div>
			<div class="rest-title"></div>
			<div class="rest-count"></div>
			<div class="rest-next"></div>
			<div class="rest-actions">
				<button class="rest-back" type="button"></button>
				<button class="rest-skip" type="button"></button>
			</div>
		</div>

		~// Exercise detail card (full technique / mistake / safety warning).
		<div class="info-overlay hidden">
			<div class="info-card">
				<div class="info-visual"><img class="info-media" alt=""></div>
				<div class="demo-controls hidden">
					<button class="demo-prev btn" type="button" aria-label=(i18n.T(l, "demo.prev"))>←</button>
					<button class="demo-toggle btn" type="button"></button>
					<button class="demo-next btn" type="button" aria-label=(i18n.T(l, "demo.next"))>→</button>
				</div>
				<div class="demo-frame hidden"></div>
				<h2 class="info-name"></h2>
				<p class="info-desc"></p>
				<div class="info-sec info-how-sec">
					<h3>~(i18n.T(l, "info.how"))</h3>
					<ol class="info-how"></ol>
				</div>
				<div class="info-sec info-correct-sec">
					<h3>~(i18n.T(l, "info.correct"))</h3>
					<ul class="info-correct"></ul>
				</div>
				<div class="info-sec info-wrong-sec">
					<h3>~(i18n.T(l, "info.wrong"))</h3>
					<ul class="info-wrong"></ul>
				</div>
				<div class="info-sec info-breathing-sec">
					<h3>~(i18n.T(l, "info.breathing"))</h3>
					<p class="info-breathing"></p>
				</div>
				<div class="info-sec info-warn-sec">
					<h3>⚠️ ~(i18n.T(l, "info.warning"))</h3>
					<p class="info-warn"></p>
				</div>
				<button class="info-replace btn" type="button">~(i18n.T(l, "info.replace"))</button>
				<button class="info-close btn primary" type="button">~(i18n.T(l, "info.close"))</button>
			</div>
		</div>

		<div class="done-overlay hidden">
			<div class="applause">👏</div>
			<div class="done-title"></div>
			<div class="done-enc"></div>
			<div class="done-streak"></div>
			<a class="btn primary back-home" href="/">~(i18n.T(l, "done.back_home"))</a>
		</div>

		<script
			src=(assets.PersistentPlayer())
			inline
			data:payload=(payload)>
		</script>
	</div>
}
