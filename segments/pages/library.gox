package pages

import (
	"context"
	"errors"

	"morning30/internal/app"
	"morning30/internal/auth"
	"morning30/internal/content"
	"morning30/internal/i18n"
	"morning30/path"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
)

// libraryPage is the exercise library: find an exercise, look at its card,
// and add it to the current program ("+": part, days and amount).
type libraryPage struct {
	sess auth.Session
	auth doors.Source[auth.Session]
	path doors.Source[path.Path]
}

// libState is the whole library screen in one comparable value.
type libState struct {
	Query   string
	Group   string
	NoJumps bool
	Card    string // exercise whose card is open
	Add     string // exercise being added
	Part    string
	Where   whereState
	Value   int
	Err     string // i18n key of the last error
	Done    string // name of the exercise just added
}

// list returns to the list, keeping the search and filters.
func (s libState) list() libState {
	return libState{Query: s.Query, Group: s.Group, NoJumps: s.NoJumps}
}

elem (p libraryPage) Main() {
	~{
		l := i18n.Lang(p.sess.Lang)
		st := doors.NewSource(libState{})
		figure := doors.NewSource(app.DB.GetSex(p.sess.UserID))
	}
	<title>~(i18n.T(l, "library.title"))</title>
	<main class="screen">
		<section class="library">
			~(st.Bind(elem(s libState) {
				~(if s.Add != "" {
					~(p.addSheet(l, st, s))
				} else if s.Card != "" {
					~(exerciseCard{userID: p.sess.UserID, lang: p.sess.Lang, id: s.Card, figure: figure,
						onBack: func(ctx context.Context) { st.Update(ctx, s.list()) },
						onAdd:  func(ctx context.Context) { st.Update(ctx, p.startAdd(s, s.Card)) }})
				} else {
					~(p.list(l, st, s))
				})
			}))
		</section>
	</main>
}

// startAdd opens the add sheet with the exercise's own part and a default amount.
func (p libraryPage) startAdd(s libState, id string) libState {
	next := s.list()
	next.Add = id
	next.Part = string(content.Main)
	next.Where = whereState{Mode: "all"}
	next.Value = 10
	if def, ok := app.UserCatalog(p.sess.UserID).Def(id); ok {
		if def.Slot != "" {
			next.Part = string(def.Slot)
		}
		next.Value = content.DefaultValue(def.Unit)
	}
	return next
}

elem (p libraryPage) list(l i18n.Lang, st doors.Source[libState], s libState) {
	~{
		items := app.Library(p.sess.UserID, p.sess.Lang, s.Group, s.Query, s.NoJumps)
		all := app.Library(p.sess.UserID, p.sess.Lang, "", "", false)
		used := map[string]bool{}
		for _, e := range all {
			used[e.Group] = true
		}
		fig := app.DB.GetSex(p.sess.UserID)
		group := ""
	}
	<div class="lib-head">
		~>doors.ALink{Model: path.Path{Page: path.Editor}} <a class="lib-back" aria-label=(i18n.T(l, "settings.editor"))>←</a>
		<h1>~(i18n.T(l, "library.title"))</h1>
	</div>
	~(if s.Done != "" {
		<p class="ok-msg" role="status">~(i18n.Tf(l, "library.added", s.Done, app.ProgramTitle(p.sess.UserID, p.sess.Lang)))</p>
	})
	<input class="text-input search" type="search" value=(s.Query) placeholder=(i18n.T(l, "library.search")) aria-label=(i18n.T(l, "library.search"))
		(doors.AChange{On: func(ctx context.Context, r doors.RequestEvent[doors.ChangeEvent]) bool {
			st.Update(ctx, libState{Query: r.Event().Value, Group: s.Group, NoJumps: s.NoJumps})
			return false
		}})>
	<div class="chips">
		~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
			st.Update(ctx, libState{Query: s.Query, NoJumps: s.NoJumps})
			return false
		}} <button type="button" class=(chipClass(s.Group == ""))>~(i18n.T(l, "programs.all"))</button>
		~(for _, g := range app.LibraryGroups() {
			~(if used[g] {
				~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
					st.Update(ctx, libState{Query: s.Query, Group: g, NoJumps: s.NoJumps})
					return false
				}} <button type="button" class=(chipClass(s.Group == g))>~(i18n.T(l, "grp."+g))</button>
			})
		})
	</div>
	<div class="toggles">
		~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
			st.Update(ctx, libState{Query: s.Query, Group: s.Group, NoJumps: !s.NoJumps})
			return false
		}} <button type="button" class=(toggleClass(s.NoJumps))><span class="sw"></span>~(i18n.T(l, "filter.nojumps"))</button>
	</div>
	~(if len(items) == 0 {
		<p class="lib-intro">~(i18n.T(l, "library.nothing"))</p>
	})
	<div class="lib-list">
		~(for _, e := range items {
			~(if s.Group == "" && e.Group != group {
				~{ group = e.Group }
				<h2 class="lib-grp">~(i18n.T(l, "grp."+e.Group))</h2>
			})
			<div class="lib-item">
				~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
					next := s.list()
					next.Card = e.ID
					st.Update(ctx, next)
					toTop(r)
					return false
				}} <button class="lib-open" type="button">
					~(if src := firstFrameOf(p.sess.UserID, e.ID, fig); src != "" {
						<img class="lib-thumb" loading="lazy" src=(src) alt="">
					} else {
						<span class="lib-thumb"></span>
					})
					<span class="lib-item-name">~(e.Name)</span>
				</button>
				~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
					st.Update(ctx, p.startAdd(s, e.ID))
					toTop(r)
					return false
				}} <button class="add-btn" type="button" aria-label=(i18n.T(l, "library.add_to_program"))>+</button>
			</div>
		})
	</div>
}

// addSheet asks where, on which days and how much, then adds the exercise.
elem (p libraryPage) addSheet(l i18n.Lang, st doors.Source[libState], s libState) {
	~{
		cat := app.UserCatalog(p.sess.UserID)
		def, _ := cat.Def(s.Add)
		step := 1
		if def.Unit == content.Seconds {
			step = 5
		}
		with := func(change func(*libState)) libState {
			next := s
			next.Err = ""
			change(&next)
			return next
		}
		today := app.CurrentDay(p.sess.UserID)
	}
	<div class="sheet">
		<h1>~(cat.Name(l, s.Add))</h1>
		<p class="lib-intro">~(i18n.Tf(l, "library.into", app.ProgramTitle(p.sess.UserID, p.sess.Lang)))</p>
		<h2 class="lib-grp">~(i18n.T(l, "library.part"))</h2>
		<div class="seg3">
			~(for _, part := range []struct{ Slot, Key string }{{"warmup", "workout.warmup"}, {"main", "workout.main"}, {"cooldown", "workout.cooldown"}} {
				~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
					st.Update(ctx, with(func(n *libState) { n.Part = part.Slot }))
					return false
				}} <button type="button" class=(segClass(s.Part == part.Slot))>~(i18n.T(l, part.Key))</button>
			})
		</div>
		<h2 class="lib-grp">~(i18n.T(l, "library.days"))</h2>
		~(wherePicker(l, s.Where, func(ctx context.Context, w whereState) {
			st.Update(ctx, with(func(n *libState) { n.Where = w }))
		}))
		<h2 class="lib-grp">~(i18n.T(l, "library.amount"))</h2>
		<div class="stepper">
			~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
				st.Update(ctx, with(func(n *libState) {
					if n.Value-step >= 1 {
						n.Value -= step
					}
				}))
				return false
			}} <button type="button" aria-label="−">−</button>
			<b>~(doseLabel(l, string(def.Unit), s.Value, def.PerSide))</b>
			~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
				st.Update(ctx, with(func(n *libState) { n.Value += step }))
				return false
			}} <button type="button" aria-label="+">+</button>
		</div>
		~(if s.Err != "" {
			<p class="err" role="alert">~(i18n.T(l, s.Err))</p>
		})
		<div class="preview-actions">
			~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
				err := app.AddToCurrent(p.sess.UserID, s.Add, content.Slot(s.Part), s.Where.days(today), s.Value)
				if err != nil {
					key := "today.edit_failed"
					if errors.Is(err, content.ErrNoDays) {
						key = "library.no_days"
					}
					st.Update(ctx, with(func(n *libState) { n.Err = key }))
					return false
				}
				done := s.list()
				done.Done = cat.Name(l, s.Add)
				st.Update(ctx, done)
				return false
			}} <button class="btn primary" type="button">~(i18n.T(l, "library.add"))</button>
			~>doors.AClick{On: func(ctx context.Context, r doors.RequestPointer) bool {
				st.Update(ctx, s.list())
				return false
			}} <button class="btn" type="button">~(i18n.T(l, "settings.cancel"))</button>
		</div>
	</div>
}

var _ = gox.Elem(nil)
